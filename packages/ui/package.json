{
  "name": "@flxra/ui",
  "version": "0.1.0",
  "description": "Flxra React components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheesebuhrger/flxra.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/cheesebuhrger/flxra#readme",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@flxra/tokens": "^0.1.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
